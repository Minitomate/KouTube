{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KouTube",
  "version": "1.2.0",
  "identifier": "com.koutube.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../frontend run dev -- --port 5173",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "KouTube",
        "width": 720,
        "height": 900,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Minitomate/KouTube/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxQjM5QUM5Mzk3MjRCMDAKUldRQVMzSTV5WnF6WVl6ZFdmNDJlNDgvZ2lZNjFzZ0p6aXpJbjFoMXJ1ajhsdHp0RnNNeDIrTmsK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
